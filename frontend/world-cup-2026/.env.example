# Copy this file as .env.local and fill in your values
# Copia este archivo como .env.local y rellena tus valores

# ── Backend API ───────────────────────────────────────────────────────────────
# URL base del backend Spring Boot (default: localhost:8082)
# VITE_API_URL=http://localhost:8082

# ── Stripe Sandbox ────────────────────────────────────────────────────────────
# Obtén tu Publishable Key en: https://dashboard.stripe.com/test/apikeys
# Get your Publishable Key from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PK=pk_test_REEMPLAZA_CON_TU_PUBLISHABLE_KEY

# ── Firebase FCM (Push Notifications / RNF-15) ────────────────────────────────
# Obtén estos valores en: Firebase Console → Tu proyecto → Configuración → General → Tus apps
# Get from: Firebase Console → Your project → Settings → General → Your apps
VITE_FIREBASE_API_KEY=REEMPLAZA_CON_TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZA_CON_TU_SENDER_ID
VITE_FIREBASE_APP_ID=1:REEMPLAZA:web:REEMPLAZA
# VAPID Key: Firebase Console → Cloud Messaging → Configuración web → Certificados push web
# VAPID Key: Firebase Console → Cloud Messaging → Web push certificates
VITE_FIREBASE_VAPID_KEY=REEMPLAZA_CON_TU_VAPID_KEY

# ── GNews API (World Cup News / Noticias del Mundial) ─────────────────────────
# Registrate gratis en https://gnews.io (100 requests/día gratis)
# Register free at https://gnews.io (100 requests/day free tier)
VITE_GNEWS_API_KEY=REEMPLAZA_CON_TU_GNEWS_KEY

# ── i18n / Internationalization (RNF-17) ─────────────────────────────────────
# Idiomas soportados: es (Español), en (English), fr (Français)
# Supported languages: es (Spanish), en (English), fr (French)
# Stored in localStorage key: wc2026_lang
# Default fallback language: es

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Descomenta / Uncomment to enable experimental features
# VITE_ENABLE_SUPERPOLLA=true
